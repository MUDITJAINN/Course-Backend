# --- Core ---
PORT=4001
NODE_ENV=development
MONGO_URI=
JWT_USER_PASSWORD=
JWT_ADMIN_PASSWORD=
SITE_NAME=Programming With Mudit

BACKEND_URL=http://localhost:4001
FRONTEND_URL=http://localhost:5173
FRONTEND_URL1=http://localhost:5173
FRONTEND_URL2=
FRONTEND_URL3=
FRONTEND_URL4=
NOTE_FILES_DIR=secure-notes

# --- Cloudinary (course images) ---
# cloud_name=
# api_key=
# api_secret=

# --- PhonePe (sandbox) — CLIENT_* or legacy MERCHANT_ID / SALT_KEY ---
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# --- PDF: local (dev) | r2 (production) ---
PDF_STORAGE=local
# PDF_STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=course-notes
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# --- Chatbot (Groq) ---
CHATBOT_ENABLED=true
CHATBOT_ROUTE_PATH=/api/v1/chatbot
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.groq.com/openai/v1
CHATBOT_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_CONTEXT_CHARS=12000
CHATBOT_MAX_HISTORY_TURNS=8
CHATBOT_MAX_TOKENS=700
CHATBOT_TEMPERATURE=0.4
CHATBOT_RATE_LIMIT_PER_MIN=15

# --- AI tutor ---
TUTOR_ENABLED=true
TUTOR_ROUTE_PATH=/api/v1/tutor
PDF_STORAGE=local
TUTOR_LLM_API_KEY=
TUTOR_LLM_BASE_URL=https://api.groq.com/openai/v1
TUTOR_LLM_MODEL=llama-3.3-70b-versatile
TUTOR_CHUNK_SIZE=900
TUTOR_CHUNK_OVERLAP=120
TUTOR_RAG_TOP_K=6
TUTOR_MAX_CONTEXT_CHARS=10000
TUTOR_MAX_HISTORY_TURNS=6
TUTOR_MAX_TOKENS=900
TUTOR_TEMPERATURE=0.3
TUTOR_RATE_LIMIT_PER_MIN=20

# Embeddings — Jina
TUTOR_EMBED_PROVIDER=jina
TUTOR_EMBED_BASE_URL=https://api.jina.ai/v1
TUTOR_EMBED_API_KEY=
TUTOR_EMBED_MODEL=jina-embeddings-v3

# Vectors — Weaviate (https://weaviate.io — free sandbox)
TUTOR_VECTOR_STORE=weaviate
WEAVIATE_URL=http://localhost:8080
# WEAVIATE_URL=https://xxxxxxxx.weaviate.network
# WEAVIATE_API_KEY=
WEAVIATE_CLASS=TutorChunk

# Redis cache (Upstash)
# REDIS_URL=rediss://...
REDIS_RAG_TTL_SECONDS=600

# Qdrant (alternative vectors)
# TUTOR_VECTOR_STORE=qdrant
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=tutor_chunks

# Dev fallback
# TUTOR_VECTOR_STORE=mongodb
# TUTOR_EMBED_PROVIDER=ollama
# TUTOR_OLLAMA_URL=http://localhost:11434
